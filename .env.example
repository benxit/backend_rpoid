# Copia este archivo como ".env" y completa los valores reales.
# El archivo ".env" NUNCA se sube a GitHub (ver .gitignore).

SECRET_KEY=cambia-esta-clave-por-una-generada-para-produccion
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,IP_PUBLICA_DE_TU_EC2

# DB_ENGINE=mysql   -> para la instancia EC2 (requerido por la pauta)
# DB_ENGINE=sqlite  -> solo para pruebas rapidas locales
DB_ENGINE=mysql
DB_NAME=django_evaluacion
DB_USER=django_user
DB_PASSWORD=cambia-esta-clave
DB_HOST=localhost
DB_PORT=3306
